PORT=8790
# Exact browser origin for auth, email confirmation and password reset links.
# Use your HTTPS storefront origin on the Linux server.
STOREFRONT_PUBLIC_URL=http://127.0.0.1:8790
SALEOR_GRAPHQL_URL=https://your-saleor.example/graphql/
SALEOR_CHANNEL=default-channel
# Optional HTTPS endpoint (for example n8n) that accepts a JSON sales lead.
MANAGER_WEBHOOK_URL=
# Optional secret sent to the manager webhook as Bearer token.
MANAGER_WEBHOOK_TOKEN=
# Public URL of a read-only stock bridge. It must return {items:[{sku,location,quantity,updatedAt}]}.
INVENTORY_API_URL=
INVENTORY_API_TOKEN=
STOCK_MAX_AGE_SECONDS=120
